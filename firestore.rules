rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque utilisateur connecté ne lit et n'écrit que ses propres données.
    match /users/{uid}/app/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && docId in ['state', 'custom']
        && request.resource.data.keys().hasOnly(['updatedAt', 'json'])
        && request.resource.data.updatedAt is number
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000;
    }
    // Tout le reste est interdit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
